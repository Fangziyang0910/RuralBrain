# RuralBrain 环境配置
# 复制此文件为 .env 并填入实际值
#
# 注意：服务地址、路径、模型参数等已移至 src/config.py
#       此文件仅保留 API 密钥和调试开关

# ===== API 密钥 =====

# DeepSeek API（必填）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 获取: https://platform.deepseek.com/api_keys

# 智谱AI GLM API（可选）
# ZHIPUAI_API_KEY=your_zhipuai_api_key_here
# 获取: https://open.bigmodel.cn/usercenter/apikeys

# LangSmith API（可选，调试用）
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# 获取: https://smith.langchain.com/settings

# ===== 调试开关 =====

# LangSmith 追踪（生产建议关闭）
LANGSMITH_TRACING=false

# LangChain 后台回调
LANGCHAIN_CALLBACKS_BACKGROUND=false
