# RuralBrain 环境配置示例文件
# 复制此文件为 .env 并填入实际的配置值
#
# 配置原则：此文件只保留 API 密钥类信息和调试开关
# 其他所有配置（服务地址、路径、模型参数等）已移到 src/config.py 中
# 如需修改这些参数，请编辑 src/config.py 文件

# ============================================
# 🔑 API 密钥配置（必填）
# ============================================

# DeepSeek API 密钥
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 智谱AI (GLM) API 密钥（可选）
# 获取地址: https://open.bigmodel.cn/usercenter/apikeys
# ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# 千问 (DashScope) API 密钥（推荐用于 Embedding）
# 获取地址: https://help.aliyun.com/zh/dashscope/developer-reference/activate-dashscope
# 设置后需要在 src/config.py 中配置 EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# OpenAI API 密钥（可选，用于 OpenAI Embedding）
# OPENAI_API_KEY=your_openai_api_key_here

# LangSmith API 密钥（可选，用于调试和监控 Agent 行为）
# 获取地址: https://smith.langchain.com/settings
# LANGSMITH_API_KEY=your_langsmith_api_key_here

# ============================================
# 🐛 调试配置（生产环境建议关闭）
# ============================================

# LangSmith 追踪（生产建议关闭）
LANGSMITH_TRACING=false

# 是否在后台运行回调
LANGCHAIN_CALLBACKS_BACKGROUND=false
