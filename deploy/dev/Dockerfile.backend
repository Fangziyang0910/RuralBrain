# RuralBrain Backend Development Dockerfile
# 开发环境镜像 - 支持热重载
FROM python:3.13-slim

WORKDIR /app

# 安装系统依赖（使用重试机制）
RUN apt-get update --fix-missing -o Acquire::Retries=3 -o Acquire::http::Timeout=60 && \
    apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    libopencv-dev \
    python3-opencv \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv 包管理器（使用官方安装脚本）
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_HTTP_TIMEOUT=600 \
    PYTHONPATH=/app

# 复制项目依赖配置文件
COPY pyproject.toml uv.lock ./

# 复制源代码
COPY . .

# 安装依赖（包含开发依赖，支持热重载）
RUN uv sync --frozen

# 创建必要的目录
RUN mkdir -p uploads pest_results cow_results rice_results

# 暴露端口
EXPOSE 8080

# 启动命令（使用 uvicorn --reload 实现热重载）
# 注意：run_server.py 中已配置 reload=True
CMD ["uv", "run", "python", "run_server.py"]
