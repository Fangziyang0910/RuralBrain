# RuralBrain Backend Development Dockerfile
# 开发环境镜像 - 支持热重载
FROM python:3.13-slim

WORKDIR /app

# 安装系统依赖（使用重试机制）
# 配置阿里云镜像源加速下载
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get clean
# 使用 cache mount 缓存 APT 下载，加速后续构建
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update --fix-missing -o Acquire::Retries=3 -o Acquire::http::Timeout=60 && \
    apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    libopencv-dev \
    python3-opencv \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv 包管理器（使用官方安装脚本）
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_HTTP_TIMEOUT=600 \
    PYTHONPATH=/app

# 复制项目依赖配置文件
COPY pyproject.toml uv.lock ./

# 安装依赖（包含开发依赖，支持热重载）
# 使用 cache mount 缓存 uv 下载，加速后续构建
# 注意：开发环境代码通过 volume 挂载，不需要 COPY
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

# 创建必要的目录
RUN mkdir -p uploads pest_results cow_results rice_results

# 暴露端口
EXPOSE 8080

# 启动命令（使用 uvicorn --reload 实现热重载）
# 注意：run_server.py 中已配置 reload=True
CMD ["uv", "run", "python", "run_server.py"]
