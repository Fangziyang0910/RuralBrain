# .dockerignore for RuralBrain Backend

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
.uv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
docs/

# Environment
.env
.env.local
.env.*.local

# Test
.pytest_cache/
.coverage
htmlcov/
.tox/
tests/

# Logs
*.log
logs/

# OS
Thumbs.db
.DS_Store

# Model files (too large)
*.pth
*.pt
*.onnx
*.weights

# Temporary files (stored in /tmp, managed by tmpfs in Docker)
# Uploads and results are now stored in system temp directory
/tmp/ruralbrain/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Frontend (not needed in backend image)
frontend/
