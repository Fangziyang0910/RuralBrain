# Planning Service Dockerfile (优化版 - 多阶段构建)
# 使用构建器模式：构建阶段包含所有依赖，运行阶段只复制必要的部分

# ========== 构建阶段 ==========
FROM python:3.13-slim AS builder

WORKDIR /app

# 安装构建依赖（只在这个阶段需要）
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# 安装 uv 包管理器
RUN pip install --no-cache-dir uv

# 复制依赖文件
COPY docker/requirements.planning.txt ./requirements.txt

# 使用 uv 安装依赖到临时目录
RUN uv pip install --system --target /install -r requirements.txt

# ========== 运行阶段 ==========
FROM python:3.13-slim

WORKDIR /app

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    SERVICE_PORT=8003 \
    SERVICE_HOST=0.0.0.0 \
    PATH="/app/.venv/bin:$PATH"

# 只安装运行时需要的系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# 从构建阶段复制安装好的包
COPY --from=builder /install /usr/local

# 复制应用代码
COPY src/ ./src/

# 复制知识库数据(包含 ChromaDB)
COPY knowledge_base ./knowledge_base

# 创建非 root 用户
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

# 暴露端口
EXPOSE 8003

# 健康检查
HEALTHCHECK --interval=30s --timeout=30s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8003/health || exit 1

# 启动命令
CMD ["python", "-m", "uvicorn", "src.rag.service.main:app", "--host", "0.0.0.0", "--port", "8003"]
