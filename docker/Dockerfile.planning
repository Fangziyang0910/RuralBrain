# Planning Service Dockerfile
# 独立的乡村规划咨询服务微服务（优化版，不包含深度学习依赖）
ARG PYTHON_VERSION=3.13-slim
FROM python:${PYTHON_VERSION}

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    SERVICE_PORT=8003 \
    SERVICE_HOST=0.0.0.0 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 安装系统依赖（带重试机制）
RUN for i in 1 2 3; do \
    apt-get update --fix-missing -o Acquire::Retries=10 -o Acquire::http::Timeout=600 && \
    apt-get install -y --no-install-recommends --fix-missing \
    curl \
    && rm -rf /var/lib/apt/lists/* && exit 0; \
    echo "Retry $i failed, trying again..."; \
    sleep 5; \
    done; exit 1

# 复制并安装独立依赖（只包含 RAG 相关，不含 torch/ultralytics）
COPY docker/requirements.planning.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 复制应用代码
COPY src/ ./src/

# 创建知识库目录（通过卷挂载提供，不打包到镜像中）
RUN mkdir -p ./knowledge_base

# 创建非 root 用户
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

# 暴露端口
EXPOSE 8003

# 健康检查
HEALTHCHECK --interval=30s --timeout=30s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8003/health || exit 1

# 启动命令
CMD ["python", "-m", "uvicorn", "src.rag.service.main:app", "--host", "0.0.0.0", "--port", "8003"]
