# Planning Service Dockerfile
# 独立的乡村规划咨询服务微服务
ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    SERVICE_PORT=8003 \
    SERVICE_HOST=0.0.0.0

# 安装系统依赖（带重试机制）
RUN for i in 1 2 3; do \
    apt-get update --fix-missing -o Acquire::Retries=10 -o Acquire::http::Timeout=600 && \
    apt-get install -y --no-install-recommends --fix-missing \
    curl \
    && rm -rf /var/lib/apt/lists/* && exit 0; \
    echo "Retry $i failed, trying again..."; \
    sleep 5; \
    done; exit 1

# 复制 uv 并安装依赖（统一使用 pyproject.toml/uv.lock）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --python 3.13

# 复制应用代码
COPY src/ ./src/

# 创建知识库目录（通过卷挂载提供，不打包到镜像中）
RUN mkdir -p ./knowledge_base

# 创建非 root 用户
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

# 暴露端口
EXPOSE 8003

# 健康检查
HEALTHCHECK --interval=30s --timeout=30s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8003/health || exit 1

# 启动命令
CMD ["uv", "run", "uvicorn", "src.rag.service.main:app", "--host", "0.0.0.0", "--port", "8003"]
