# RuralBrain Triple Detector Production Dockerfile
# 统一检测服务 - 整合病虫害、大米、奶牛三个检测服务
FROM python:3.12-slim

WORKDIR /app

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    YOLO_CONFIG_DIR=/app/ultralytics

# 安装系统依赖（YOLOv8 需要的依赖）
# 配置阿里云镜像源加速下载
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get clean
# 使用 cache mount 缓存 APT 下载，加速后续构建
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update --fix-missing -o Acquire::Retries=3 -o Acquire::http::Timeout=60 && \
    apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    libopencv-dev \
    python3-opencv \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv 包管理器
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# 复制项目依赖配置文件
COPY pyproject.toml uv.lock ./

# 安装 Python 依赖（使用 cache mount 缓存）
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# 复制统一检测服务代码
COPY src/algorithms/triple_detector ./triple_detector/

# 复制三个检测服务的模型目录（保持原有结构）
COPY src/algorithms/pest_detection/detector/models ./triple_detector/pest/models/
COPY src/algorithms/rice_detection/detector/models ./triple_detector/rice/models/
COPY src/algorithms/cow_detection/detector/models ./triple_detector/cow/models/

# 创建非root用户并设置权限
RUN useradd --create-home --shell /bin/bash appuser && \
    mkdir -p /app/triple_detector/uploads /app/ultralytics && \
    chown -R appuser:appuser /app

USER appuser

# 切换到统一服务目录
WORKDIR /app/triple_detector

# 暴露统一服务端口
EXPOSE 8001

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# 启动统一检测服务（单 uvicorn 进程）
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
