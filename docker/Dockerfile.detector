# RuralBrain Algorithm Service Production Dockerfile
# 统一算法服务 - FastAPI 网关 + 检测算法模块
FROM python:3.13-slim

WORKDIR /app

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/algorithms \
    YOLO_CONFIG_DIR=/app/ultralytics \
    UV_CACHE_DIR=/tmp/uv-cache

# 安装系统依赖（YOLOv8 需要的依赖，带重试机制）
# 注意：opencv-python 通过 uv 安装，不需要 apt 安装 python3-opencv
# 添加 libgl1 等 OpenCV 运行时需要的库
RUN for i in 1 2 3; do \
    apt-get update && \
    apt-get install -y --no-install-recommends --fix-missing \
    build-essential \
    cmake \
    pkg-config \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/* && exit 0; \
    echo "Retry $i failed, trying again..."; \
    sleep 5; \
    done; exit 1

# 安装 uv 包管理器
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# 复制项目依赖配置文件
COPY pyproject.toml uv.lock ./

# 安装 Python 依赖（显式使用 Python 3.13，避免自动下载 3.14）
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --python 3.13

# 复制算法服务代码（包含 API 网关和检测算法）
COPY src/algorithms ./algorithms/

# 创建非root用户并设置权限
RUN useradd --create-home --shell /bin/bash appuser && \
    mkdir -p /app/ultralytics /tmp/uv-cache && \
    chown -R appuser:appuser /app /tmp/uv-cache

USER appuser

# 切换到算法服务目录
WORKDIR /app/algorithms

# 暴露统一服务端口
EXPOSE 8001

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# 启动统一算法服务（FastAPI 网关）
CMD ["uv", "run", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8001"]
