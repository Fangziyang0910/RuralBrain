# Planning Service 独立镜像 Dockerfile
# 用于构建可发布到 Docker Hub 的规划服务镜像

# ========== 构建阶段 ==========
FROM python:3.13-slim AS builder

WORKDIR /build

# 安装构建依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# 安装 uv 包管理器
RUN pip install --no-cache-dir uv

# 复制依赖文件
COPY docker/requirements.planning.txt requirements.txt

# 使用 pip 安装依赖到系统目录
RUN pip install --no-cache-dir --target /install -r requirements.txt

# ========== 运行阶段 ==========
FROM python:3.13-slim

LABEL maintainer="zhihongsheng"
LABEL description="RuralBrain Planning Service - RAG-based rural planning consultation service"
LABEL version="1.0.0"

WORKDIR /app

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/install \
    SERVICE_PORT=8003 \
    SERVICE_HOST=0.0.0.0 \
    KNOWLEDGE_BASE_PATH=/app/knowledge_base \
    CHROMA_PERSIST_DIR=/app/knowledge_base/chroma_db \
    VECTOR_DB_TYPE=chroma

# 安装运行时依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# 从构建阶段复制安装好的包
COPY --from=builder /install /install

# 复制应用代码
COPY src/ ./src/

# 创建知识库目录（数据将通过卷挂载提供）
RUN mkdir -p ./knowledge_base

# 创建非 root 用户
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

# 暴露端口
EXPOSE 8003

# 健康检查
HEALTHCHECK --interval=30s --timeout=30s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8003/health || exit 1

# 启动命令
CMD ["python", "-m", "uvicorn", "src.rag.service.main:app", "--host", "0.0.0.0", "--port", "8003"]
