# RuralBrain Backend Service - 轻量级版本
# FastAPI 后端服务，移除不必要的重量级依赖
FROM python:3.13-slim

WORKDIR /app

# 配置 APT 镜像源（阿里云）
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends curl catdoc && \
    rm -rf /var/lib/apt/lists/*

# 升级 pip 并安装构建工具
RUN pip install -i https://pypi.tuna.tsinghua.edu.cn/simple --upgrade pip && \
    pip install -i https://pypi.tuna.tsinghua.edu.cn/simple setuptools wheel

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 安装最小依赖 - 后端服务必需的包
# 不包含 torch、ul ultralytics、chromadb 等重量级依赖
# 注意：不指定具体版本，让 pip 自动选择与 Python 3.13 兼容的最新版本
RUN pip install -i https://pypi.tuna.tsinghua.edu.cn/simple \
    fastapi \
    uvicorn[standard] \
    pydantic \
    pydantic-settings \
    python-multipart \
    python-dotenv \
    requests \
    langchain \
    langchain-deepseek \
    langgraph \
    langsmith \
    langchain-chroma \
    langchain-community \
    sentence-transformers \
    chromadb \
    markitdown \
    rich \
    --no-cache-dir

# 额外的运行时依赖（单独分层，便于快速更新）
RUN pip install -i https://pypi.tuna.tsinghua.edu.cn/simple \
    langchain-text-splitters \
    cachetools \
    filetype \
    python-pptx \
    dashscope \
    --no-cache-dir

# 复制后端代码
COPY run_server.py /app/
COPY service /app/service
COPY src/agents /app/src/agents
COPY src/config.py /app/src/
COPY src/utils /app/src/utils
COPY src/rag /app/src/rag

# ==================== 疾病知识库构建（独立层，便于缓存）====================

# 声明构建参数（通过 --build-arg 传入）
ARG QWEN_API_KEY

# 复制知识库构建脚本
COPY scripts/deploy/build_disease_kb.py /app/scripts/deploy/

# 复制疾病知识库源文档
COPY knowledge_base/diseases/documents /app/knowledge_base/diseases/documents

# 构建疾病知识库
# 向量数据库将存储在 /app/knowledge_base/diseases/chroma_db/
# 通过命令行参数传递 API 密钥
RUN python scripts/deploy/build_disease_kb.py --qwen-api-key="${QWEN_API_KEY}" && \
    # 构建完成后删除源文档以减小镜像体积
    rm -rf /app/knowledge_base/diseases/documents

# ==================== 疾病知识库构建完成 ====================

# 创建临时文件目录
RUN mkdir -p /tmp/ruralbrain

# 暴露端口
EXPOSE 8081

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8081/docs || exit 1

# 启动命令
CMD ["python", "run_server.py"]
