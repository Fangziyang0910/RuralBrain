# RuralBrain Planning Service Development Dockerfile
# 开发环境镜像 - 支持热重载
FROM python:3.13-slim

WORKDIR /app

# 安装系统依赖
# 不使用 cache mount 避免缓存损坏的数据
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv 包管理器（使用官方安装脚本）
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    PYTHONPATH=/app

# 复制项目依赖配置文件
COPY pyproject.toml uv.lock ./

# 安装依赖（包含开发依赖）
# 显式使用 Python 3.13
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --python 3.13

# 创建知识库目录
RUN mkdir -p knowledge_base

# 暴露端口
EXPOSE 8003

# 启动命令（使用 uvicorn --reload 实现热重载）
CMD ["uv", "run", "uvicorn", "src.rag.service.main:app", "--host", "0.0.0.0", "--port", "8003", "--reload"]
