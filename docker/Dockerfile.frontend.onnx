# RuralBrain Frontend - 轻量级生产版本
# Next.js 前端应用
FROM node:20-alpine AS builder

WORKDIR /app

# 设置 npm 镜像源（加速国内下载）
RUN npm config set registry https://registry.npmmirror.com

# 构建时参数（用于 NEXT_PUBLIC_* 环境变量）
ARG NEXT_PUBLIC_MANAGEMENT_URL=http://114.132.186.148:3000
ARG NEXT_PUBLIC_PLANNING_URL=http://114.132.186.148:3003
ARG NEXT_PUBLIC_LEGAL_URL=http://114.132.186.148:3004

# 设置环境变量（构建时固化到代码中）
ENV NEXT_PUBLIC_MANAGEMENT_URL=$NEXT_PUBLIC_MANAGEMENT_URL
ENV NEXT_PUBLIC_PLANNING_URL=$NEXT_PUBLIC_PLANNING_URL
ENV NEXT_PUBLIC_LEGAL_URL=$NEXT_PUBLIC_LEGAL_URL

# 复制 package.json 和 package-lock.json
COPY package*.json ./

# 安装依赖
RUN npm ci

# 复制源代码
COPY . .

# 构建应用
RUN npm run build

# 生产镜像
FROM node:20-alpine

WORKDIR /app

# 安装 curl 用于健康检查
RUN apk add --no-cache curl

# 设置环境变量 - 端口设为 3001，监听所有接口
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3001 \
    HOSTNAME=0.0.0.0

# 从构建阶段复制 standalone 产物
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

# 暴露端口
EXPOSE 3001

# 健康检查（使用 curl）
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3001 || exit 1

# 启动命令 - standalone 模式
CMD ["node", "server.js"]
