# RuralBrain Frontend Development Dockerfile
# 开发环境镜像 - 支持热重载
FROM node:20-alpine

WORKDIR /app

# 安装依赖
RUN apk add --no-cache libc6-compat curl

# 复制 package 文件
COPY package.json package-lock.json* ./

# 安装依赖（使用 --prefer-offline 加速构建）
RUN npm ci --prefer-offline --no-audit

# 设置环境变量
ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=development

# 暴露端口
EXPOSE 3000

# 开发模式启动（支持热重载）
CMD ["npm", "run", "dev"]
